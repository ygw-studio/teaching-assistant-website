# AI chat uses each user's personal Beijing Bailian API Key, bound in Profile.
# Existing platform AI_* / DEEPSEEK_* keys are NOT used as a fallback.
# Production: generate a Fernet key and keep it in a secret store, not Git.
# AI_KEY_ENCRYPTION_KEY=<Fernet key>
# Development generates backend/data/.ai-credential-encryption.key on first bind.

# Application environment. Production must set a dedicated DATABASE_PATH.
APP_ENV=development
DATABASE_PATH=data/teaching-platform.db
SESSION_TTL_HOURS=8
# Optional local-only role preview; production ignores this even if enabled.
# ENABLE_LOCAL_DEMO_ACCESS=true

# Production example:
# APP_ENV=production
# DATABASE_PATH=D:/TeachingAssistant/data/teaching-platform.db
# CORS_ORIGINS=https://teach.example.edu.cn
# BOOTSTRAP_ADMIN_ACCOUNT=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
# BOOTSTRAP_ADMIN_NAME=System Administrator

# Student code execution. Never use local mode in production.
CODE_EXECUTION_MODE=local
EXECUTION_TIMEOUT_SECONDS=10
# CODE_RUNNER_IMAGE=python:3.12-alpine

# Legacy deployment variables below are not used by personal Qwen chat.
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_API_KEY=请填写你的 DeepSeek API Key
# DEEPSEEK_MODEL=deepseek-v4-flash
